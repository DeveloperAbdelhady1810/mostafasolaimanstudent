#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Raw Firebase config copies (not needed by the build; client config lives in lib/firebase_options.dart)
/firebase/

# Never commit signing material or server keys
key.properties
*.jks
*.keystore
*.p8
*adminsdk*.json

# Real Firebase keys stay local; lib/firebase_options.dart.example is the committed template
lib/firebase_options.dart
