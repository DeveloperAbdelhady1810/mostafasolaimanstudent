// Copy this file to ios/Flutter/Secrets.xcconfig (git-ignored - never commit it) and fill in the values.
// Google Cloud console > APIs & Services > Credentials > the OAuth client of type "iOS" for the bundle id
// online.mostafasolaiman.student  (or Firebase console > Authentication > Google sign-in, then download the new
// GoogleService-Info.plist and copy CLIENT_ID and REVERSED_CLIENT_ID from it).
GOOGLE_IOS_CLIENT_ID = 000000000000-xxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.000000000000-xxxxxxxxxxxxxxxxxxxxxxxx
